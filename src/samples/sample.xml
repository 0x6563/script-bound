<div class="wrapper">
    <h2>Please enter your info</h2>
    <flow settings={"direction":"left-right"} $=($.personal)>
        <input type="text" value&=($.firstName) settings={ "label": "First Name" }/>
        <input type="text" value&=($.lastName) settings={ "label": "Last Name" } />
    </flow>
    <br/>
    <hr/> 
    <h1>Hello <($.personal.firstName)><if ($.personal.lastName)> <span><( $.personal.lastName )></span></if>!</h1>
    <flow settings={"direction":"left-right"}>
        <button class="click">
            <script event="click">
                $.counter = $.counter + 1;
            </script>
            Click this button
        </button>
        <h4 class="center">You've clicked that button <($.counter)> times!</h4>
    </flow>
    <hr/>
    <h4>Inputs</h4>
    <table>
        <tr>
            <td><input type="text" value&=($.text)/></td>
            <td><($.text)></td>
        </tr>
        <tr>
            <td><input type="checkbox" value&=($.enabled)/></td>
            <td><($.enabled)></td>
        </tr>
        <tr>
            <td>
                <for ($.colors)>
                    <label><input type="radio" value&=($root.selectedColor)/> <($)></label>
                </for>
            </td>
            <td><($.selectedColor)></td>
        </tr>
        <tr>
            <td><input type="file" value&=($.file)/></td>
            <td><($.file)></td>
        </tr>
    </table>
    <em>Powered by:</em>
    <flow settings={"direction":"left-right"}>
        <for ($.dependencies)>
            <a style="text-align:center;" href=($root.giturl .. $.slug)><($.name)></a>
        </for>
    </flow>
    <hr/>
    <h4>Pick a dependency:</h4>
    <select value&=($.selectedSlug)>
        <option value="">- choose one -</option>
        <for ($.dependencies)>
            <option value=($.slug)><($.name)></option>
        </for>
    </select>
    <!-- $= narrows scope to the query result, same as $=($.personal) does above with a plain reference -->
    <if ($.selectedSlug)>
        <div class="detail-card" $=(query d in $.dependencies filter d.slug == $.selectedSlug first d)>
            <h4><($.name)></h4>
            <p><($.description)></p>
            <p><a href=($root.giturl .. $.slug)><($root.giturl .. $.slug)></a></p>
        </div>
    </if>
</div>
<style>
    .center{
        text-align:center;
    }
    .wrapper{
        padding: 24px;
    }

    .click{
        background: blue;
        color: #FFF;
    }

    input {
        color: red;
        border: none;
        border-bottom: 2px solid black;
        font-size: 14px;

    }

    input:focus {
        outline: none;
        border-bottom: 2px solid blue;
    }

    table td {
        padding: 4px 8px;
        text-align: left;
    }
    table {
        table-layout:fixed;
        width: 100%;
        td{
            width: 35%;
        }
        tr td:last-child{
            text-align: right;
        }
    }

    [data-component="select"] {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-width: 240px;
    }

    .detail-card {
        margin-top: 8px;
        padding: 12px 16px;
        max-width: 320px;
        border: solid 1px #bbb;
    }

    .detail-card p {
        margin: 4px 0;
    }

    [data-control] {
        border: solid 1px #bbb;
        padding: 8px !important;
    }
</style>