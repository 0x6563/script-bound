<flow>
    <script event="load">
          $.personal.firstName = "John";
    </script>
    <h2>Please enter your info</h2>
    <flow settings={"direction":"left-right"} bind="$.personal">
        <input type="text" bind="$.firstName" settings={ "label": "First Name" }/>
        <input type="text" bind="$.lastName" settings={ "label": "Last Name" } />
    </flow>

    <hr/>
    <em>Powered by:</em>
    <flow settings={"direction":"left-right"}>
        <list bind="$.dependencies" settings={"direction":"left-right"}>
            <a style="text-align:center;" href=($root.giturl .. $.slug)><($.name)></a>
        </list>
    </flow>
    <h1>Hello <($.personal.firstName)><span if=($.personal.lastName)> <( $.personal.lastName )></span>!</h1>
    <flow settings={"direction":"left-right"}>
        <button>
            <script event="action">
                $.counter = $.counter + 1;
            </script>
            Click this button
        </button>
        <h4>You've clicked <($.counter)> times!</h4>
    </flow>
</flow>
<style>
    input {
        color: red;
        border: none;
        border-bottom: 2px solid black;
        font-size: 14px;

    }
    input + *{
        position: relative;
        transition: all 200ms;
        font-size: 14px;
        top: 2px;
        left: 0px;
        height: 12px;
        pointer-events:none;
    }
    input:not(:focus):placeholder-shown + * {
        font-size: 14px;
        top: -24px;
        left: 6px;
    }

    input:focus {
        outline: none;
        border-bottom: 2px solid blue;
    }

    [data-control] {
        border: solid 1px #bbb;
        padding: 8px !important;
    }
</style>